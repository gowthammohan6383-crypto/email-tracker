# MailPulse Environment Configuration
# Copy this to .env and fill in your actual values

# ─── Flask ──────────────────────────────
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
DEBUG=true
PORT=5000

# ─── Database ───────────────────────────
# SQLite (development)
DATABASE_URL=sqlite:///mailpulse.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/mailpulse

# MySQL (alternative)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mailpulse

# ─── SMTP / Email Delivery ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@mailpulse.io
FROM_NAME=MailPulse

# ─── Redis (for Celery task queue) ──────
REDIS_URL=redis://localhost:6379/0

# ─── AI / External APIs ─────────────────
OPENAI_API_KEY=sk-your-openai-key-optional
HUGGINGFACE_API_KEY=hf_your-hf-token-optional
